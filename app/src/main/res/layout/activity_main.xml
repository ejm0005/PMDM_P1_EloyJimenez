<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Título -->
    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_main"
        style="@style/EstiloTitulo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Contador (texto con parámetros) -->
    <TextView
        android:id="@+id/tvContador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/contador_tareas"
        android:textSize="14sp"
        android:textColor="@color/color_texto"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Imagen vector -->
    <ImageView
        android:id="@+id/imagenVector"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/desc_vector"
        app:srcCompat="@drawable/task_list"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="355dp"
        tools:layout_editor_absoluteY="3dp" />

    <!-- Imagen PNG -->
    <ImageView
        android:id="@+id/imagenPNG"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:contentDescription="@string/desc_bits"
        app:srcCompat="@drawable/image"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="125dp"
        tools:layout_editor_absoluteY="222dp" />

    <!-- Botón de acción -->
    <Button
        android:id="@+id/btnAccion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_guardar"
        style="@style/EstiloBoton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>