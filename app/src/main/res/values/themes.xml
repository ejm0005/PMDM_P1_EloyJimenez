<resources>
    <!-- Estilo reutilizable para los títulos -->
    <style name="EstiloTitulo">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_texto</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <!-- Estilo reutilizable para los botones -->
    <style name="EstiloBoton">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_fondo</item>
        <item name="android:backgroundTint">@color/color_primario</item>
        <item name="android:padding">12dp</item>
    </style>
</resources>